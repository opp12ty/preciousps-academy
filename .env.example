# Precious PS Academy — environment variables (names only; never commit real values)
# Copy to .env.local for local development. In Vercel, set these under Project → Settings → Environment Variables.

# PostgreSQL connection string (Neon / Vercel Postgres / any managed PostgreSQL).
# Local dev: run `npm run db:local` and use postgres://postgres@127.0.0.1:5433/postgres?sslmode=disable
DATABASE_URL=
DATABASE_POOL_MAX=5

# 32+ random characters each. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
ENCRYPTION_KEY=

# One-time setup key: the owner pastes it at /backend to create the first Super Admin (16+ chars). Remove after setup.
SETUP_TOKEN=

# SUPERADMIN_EMAIL is the only e-mail allowed to claim the platform at first-run setup (default folahandaniel@gmail.com).
# Optional alternative to the setup form: seed the first Super Admin from the environment (password must meet policy;
# a change and 2FA enrolment are forced at first sign-in). Remove after first deploy.
SUPERADMIN_EMAIL=
SUPERADMIN_INITIAL_PASSWORD=
SUPERADMIN_FIRST_NAME=
SUPERADMIN_LAST_NAME=

# Public base URL (used in e-mails, QR verification links, sitemap)
APP_URL=https://your-domain.example

# Protects /api/v1/cron/maintenance (Vercel Cron sends it as a Bearer token automatically)
CRON_SECRET=

# Optional: e-mail delivery via Resend. Without it, e-mails are held in the outbox (never falsely marked sent).
RESEND_API_KEY=
# Or any SMTP mailbox instead of Resend (e.g. Gmail: smtp.gmail.com, port 465, an App Password):
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Precious PS Academy <no-reply@your-domain.example>"

# Optional: AI question generation (Claude). All AI output enters PENDING_REVIEW.
ANTHROPIC_API_KEY=
